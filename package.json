{
  "name": "football-betting-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "copy-flags": "node scripts/copy-flags.mjs",
    "predev": "node scripts/copy-flags.mjs",
    "prebuild": "node scripts/copy-flags.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/demo_data.ts",
    "db:seed:test": "DATABASE_URL=../shared/db/test.db tsx scripts/demo_data.ts",
    "db:reset": "tsx scripts/reset.ts",
    "db:fresh": "tsx scripts/reset.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@lucia-auth/adapter-drizzle": "^1.1.0",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.45.2",
    "lucia": "^3.2.2",
    "next": "^16.2.6",
    "next-intl": "^4.13.0",
    "oslo": "^1.2.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^4.1.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "flag-icons": "^7.5.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.7"
  }
}
